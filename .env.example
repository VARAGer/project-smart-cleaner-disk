# Backend AI settings
GEMINI_API_KEY=

# Use a random string with at least 32 characters.
JWT_SECRET=change-me-to-a-long-random-secret

# Backend database
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Client local override
SMARTCLEANER_BACKEND=http://localhost:8000
SMARTCLEANER_API_TIMEOUT_SECONDS=30
AI_TOTAL_TIMEOUT_SECONDS=25.0
AI_MAX_RETRIES=1

